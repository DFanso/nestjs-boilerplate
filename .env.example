# Application Configuration
NODE_ENV=development

# Database Configuration (Local PostgreSQL)
# For special characters in password, URL-encode them (@ = %40, # = %23)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nestjs_boilerplate"

# JWT Configuration (paths to key files)
JWT_PRIVATE_KEY_PATH="./keys/private.pem"
JWT_PUBLIC_KEY_PATH="./keys/public.pem"

# Auth.js / trusted exchange bridge
# Use a long random secret shared only between Next.js server code and this Nest API.
AUTH_EXCHANGE_SECRET="replace-with-a-long-random-secret"

# Token TTLs for API auth lifecycle
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Optional: CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
